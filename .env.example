# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co

# Use the ANON / PUBLIC key here — never the service_role key.
# The anon key is safe in a browser app because Row Level Security
# restricts what it can read and write.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# n8n Chat Trigger webhook URL (optional — leave blank to disable the Ask tab)
VITE_N8N_CHAT_WEBHOOK=
